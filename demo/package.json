{
  "name": "fnb-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n account,catalog,engine,web -c magenta,blue,yellow,cyan \"npm run -s dev:account\" \"npm run -s dev:catalog\" \"npm run -s dev:server\" \"npm run -s dev:client\"",
    "dev:verbose": "concurrently -n account,catalog,engine,web -c magenta,blue,yellow,cyan \"npm run -s dev:account -- --verbose\" \"npm run -s dev:catalog -- --verbose\" \"npm run -s dev:server\" \"npm run -s dev:client\"",
    "dev:account": "node ../scripts/run-service.mjs account-service",
    "dev:catalog": "node ../scripts/run-service.mjs catalog-service",
    "dev:server": "nodemon -q --watch server --ignore server/.data --ignore \"*.test.js\" server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "test": "node --test \"server/**/*.test.js\" \"src/**/*.test.js\"",
    "migrate": "node server/db/migrate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "express": "^4.19.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "pg": "^8.23.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "nodemon": "^3.1.0",
    "vite": "^5.4.0"
  }
}
