# Copy to .env (same folder) and fill in. .env is gitignored - never commit it.
# Never put real values in THIS file: .env.example is committed to git.
# All four services read .env. See README.md "First-time setup".

# --- Supabase project (Dashboard > Project Settings > API Keys) ---------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) - or the legacy "anon" key
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) - or the legacy "service_role" key. Server-only!
SUPABASE_SECRET_KEY=
# Leave empty on new projects (tokens are checked against the project's public
# signing keys). Only set it if your project still uses the legacy JWT secret.
SUPABASE_JWT_SECRET=

# --- Database (Dashboard > Connect > Direct > Session pooler; IPv4, port 5432) --
# Copy the host exactly (it may be aws-0-... or aws-1-...).
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=
# Three services share the free pooler's small connection limit.
DB_POOL_SIZE=3

# --- Local development ---------------------------------------------------------
# true anywhere the app is served over https (the refresh cookie gets Secure)
COOKIE_SECURE=false
ACCOUNT_SERVICE_URL=http://localhost:8082
CATALOG_SERVICE_URL=http://localhost:8083
# Where the engine keeps learning state: unset = the database above,
# "pglite" = an embedded local Postgres (no Supabase needed), "memory" = lost on restart
# ENGINE_DB=

# --- AI (Claude) -----------------------------------------------------------------
# API key from platform.claude.com (billed separately from claude.ai plans).
# Unset = AI off: review text is read by keyword matching instead.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# AI_TIMEOUT_MS=6000

# --- Seed scripts ----------------------------------------------------------------
# Password for the demo community accounts created by `npm run seed:personas`
SEED_PERSONA_PASSWORD=
# Email domain for those accounts (they never receive mail)
SEED_EMAIL_DOMAIN=example.com
